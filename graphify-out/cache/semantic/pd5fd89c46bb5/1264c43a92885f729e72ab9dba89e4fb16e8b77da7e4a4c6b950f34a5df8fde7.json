{"nodes": [{"id": "readme_ms_app", "label": "MS - trabajos, repuestos y documentos (app)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_offline_first", "label": "Funciona sin internet (offline-first, datos en el dispositivo)", "file_type": "rationale", "source_file": "README.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No server or sync; all data lives on the device. Only optional email password recovery uses the network."}, {"id": "readme_not_sunat_invoicing", "label": "No es facturacion electronica SUNAT", "file_type": "rationale", "source_file": "README.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal documentation only; the accountant files it at month end."}, {"id": "readme_one_hand_usage", "label": "Uso con una mano (area tactil minima 44px)", "file_type": "rationale", "source_file": "README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used standing in a workshop or field; no long forms without partial save."}, {"id": "readme_layered_architecture", "label": "Arquitectura en capas Widget -> Controlador -> Repositorio -> SQLite", "file_type": "rationale", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each layer talks only to its neighbor, inward; presentation knows domain contracts, never implementations. Proven when adding the email account only touched data/."}, {"id": "readme_providers_wiring", "label": "app/providers.dart (unico cableado de contratos)", "file_type": "concept", "source_file": "README.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only file that knows both layers; decides which concrete implementation fulfills each contract."}, {"id": "readme_cuenta_firebase", "label": "data/cuenta/cuenta_firebase.dart (unico que importa Firebase)", "file_type": "concept", "source_file": "README.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_calculadora_totales", "label": "CalculadoraTotales (reglas de plata)", "file_type": "concept", "source_file": "README.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_igv_included_rule", "label": "IGV 18% incluido en los precios", "file_type": "rationale", "source_file": "README.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IGV is not added on top; it is broken out of the total only for display. Client pays sum of lines minus discount."}, {"id": "readme_traslado_rule", "label": "Traslado solo en campo y con movilidad propia", "file_type": "rationale", "source_file": "README.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dos_boletas_rule", "label": "Dos boletas separadas suman igual que la junta", "file_type": "rationale", "source_file": "README.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discount and tax of the second boleta are computed by difference so totals and IGV match exactly."}, {"id": "readme_mano_de_obra_rule", "label": "Mano de obra sin cantidad", "file_type": "rationale", "source_file": "README.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stock_por_linea_rule", "label": "Stock se mueve al agregar/quitar cada linea", "file_type": "rationale", "source_file": "README.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leaving without saving restores inventory to its prior state."}, {"id": "readme_fechas_iso_rule", "label": "Fechas ISO corto sin hora ni zona horaria", "file_type": "rationale", "source_file": "README.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Today is not yet overdue."}, {"id": "readme_sesion_dura_el_dia", "label": "La sesion dura el dia", "file_type": "rationale", "source_file": "README.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores login date; checked on return from background rather than with a timer, because a timer would log the technician out mid-afternoon with dirty hands."}, {"id": "readme_password_pbkdf2", "label": "Contrasena guardada como huella PBKDF2-SHA256 con sal", "file_type": "rationale", "source_file": "README.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_factory_password", "label": "Contrasena de fabrica (sin huella)", "file_type": "concept", "source_file": "README.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only password without a hash; not a secret, and absence of hash signals nobody changed it. Email linking is blocked while it is in use because such an account would belong to anyone."}, {"id": "readme_email_recovery_not_gatekeeper", "label": "El correo recupera la contrasena, no decide quien entra", "file_type": "rationale", "source_file": "README.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offline the only comparison is the local hash; letting the email account lock out the last known password would gain no security (airplane mode bypasses it) and could lock the owner out of his data. Consequence: resetting via email link does not change it on an offline phone."}, {"id": "readme_migraciones_defensivas", "label": "Migraciones que miran antes de tocar", "file_type": "rationale", "source_file": "README.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Until schema v4 the phone opened the DB without migrating, so some DBs claim version 1 but contain most tables; each step checks column/table existence and tests open faithful copies."}, {"id": "readme_fotos_tabla_propia", "label": "Fotos en tabla propia con bytes crudos y miniatura ~8KB", "file_type": "rationale", "source_file": "README.md", "source_location": "L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base64 inside the record inflated files 33%; history now loads only a small thumbnail instead of full JPEG for a 50px row."}, {"id": "readme_recordatorios_intervalo_libre", "label": "Recordatorios con intervalo libre en la unidad elegida", "file_type": "rationale", "source_file": "README.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Every 3 months' from Jan 31 lands on Apr 30, not 90 days later."}, {"id": "readme_respaldo_zip", "label": "Respaldo ZIP (datos.json + fotos/<id>.jpg)", "file_type": "concept", "source_file": "README.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers phone loss without server, account or cost. ZIP instead of DB copy because it can be opened and inspected without the app. Password never travels in the backup."}, {"id": "readme_restaurar_reemplaza", "label": "Restaurar reemplaza, no mezcla", "file_type": "rationale", "source_file": "README.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging two histories with their own correlatives would duplicate document codes."}, {"id": "readme_tarjeta_historial", "label": "Tarjeta de atencion del Historial (Hoy toca, Sin cerrar, Sin stock)", "file_type": "concept", "source_file": "README.md", "source_location": "L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows what needs attention, not money (lifetime revenue answers nothing for a solo technician). Empty cards hidden, ordered by urgency; single item shows the name as headline. Chips filter only the list, not the card."}, {"id": "readme_archivo_variable_font", "label": "Tipografia Archivo variable (eje wdth via Tipo/FontVariation)", "file_type": "concept", "source_file": "README.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Width axis lets amounts render narrow and heavy like a scoreboard without adding a second font."}, {"id": "readme_brand_palette", "label": "Paleta de marca vino #761C1C y oro #87611A, negro como superficie", "file_type": "concept", "source_file": "README.md", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_golden_screenshots", "label": "Capturas de pantalla (goldens en test/capturas/)", "file_type": "concept", "source_file": "README.md", "source_location": "L148", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "analyze and domain tests say nothing about whether the UI looks right; excluded from normal suite because pixel output depends on the generating machine."}, {"id": "readme_windows_desktop_not_target", "label": "Escritorio de Windows no es destino", "file_type": "rationale", "source_file": "README.md", "source_location": "L177", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With Firebase in the project, a Windows build downloads the Firebase C++ SDK; use the phone or Chrome instead."}, {"id": "readme_apk_build", "label": "Build APK release (Kotlin incremental desactivado en Windows)", "file_type": "concept", "source_file": "README.md", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "android/gradle.properties disables Kotlin incremental compilation because the build fails with 'Could not close incremental caches'. Signed with debug key, not Play Store ready."}, {"id": "readme_firebase_auth_spark", "label": "Recuperacion de contrasena por correo (Firebase Auth plan Spark)", "file_type": "concept", "source_file": "README.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free plan, no card, no Firestore/Storage. google-services.json not versioned because repo is public; app still builds without it, just without email recovery."}, {"id": "readme_web_preview", "label": "Vista previa en navegador (SQLite wasm)", "file_type": "concept", "source_file": "README.md", "source_location": "L214", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development preview only: photos and scanner need the phone, and browser data is separate per device."}, {"id": "readme_servir_py", "label": ".dev/servir.py (servidor con MIME .wasm)", "file_type": "concept", "source_file": "README.md", "source_location": "L230", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "python -m http.server serves .wasm with the wrong content type, the browser rejects it and SQLite never starts."}, {"id": "readme_cloud_backup_pending", "label": "Pendiente: respaldo automatico en la nube (Cloud Storage requiere Blaze)", "file_type": "concept", "source_file": "README.md", "source_location": "L239", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_web_preview", 